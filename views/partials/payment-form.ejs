<!-- Formulario de Pago -->
<%- include('success-notification') %>
<div class="fixed inset-0 bg-black bg-opacity-50 hidden overflow-y-auto" id="paymentModal">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-sm mx-auto relative my-4">
            <button type="button" class="absolute top-4 right-4 text-gray-400 hover:text-gray-500" onclick="closePaymentModal()">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <div class="p-5">
                <h3 class="text-lg font-bold text-gray-900 mb-4">Realizar Pago</h3>
                
                <!-- Información de tarjetas de prueba (colapsable) -->
                <div class="mb-4">
                    <button class="text-xs text-blue-600 hover:text-blue-800 flex items-center" onclick="toggleTestInfo()">
                        <span id="toggleIcon">▼</span>
                        <span class="ml-1">Mostrar información de prueba</span>
                    </button>
                    <div id="testInfo" class="hidden mt-2 p-2 bg-blue-50 rounded-lg text-xs">
                        <h4 class="font-semibold text-blue-800 mb-1">Tarjetas de prueba:</h4>
                        <ul class="text-blue-700 space-y-0.5 mb-2">
                            <li>• Visa: 4111111111111111</li>
                            <li>• MC: 5555555555554444</li>
                            <li>• AmEx: 378282246310005</li>
                            <li>• Discover: 6011111111111117</li>
                            <li>• JCB: 3530111333300000</li>
                            <li>• Diners: 30569309025904</li>
                        </ul>
                        <h4 class="font-semibold text-blue-800 mb-1">Estados (nombre titular):</h4>
                        <ul class="text-blue-700 space-y-0.5">
                            <li>• APPROVED: Aprobado</li>
                            <li>• REJECTED: Rechazado</li>
                            <li>• ERROR: Error</li>
                            <li>• INSUFFICIENT: Sin fondos</li>
                        </ul>
                    </div>
                </div>

                <form id="paymentForm" action="/payment/add" method="POST" class="space-y-3">
                    <input type="hidden" name="service_type" id="serviceType">
                    
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1">Correo electrónico</label>
                        <input type="email" name="email" required
                            class="w-full px-2.5 py-1.5 border border-gray-300 rounded-md focus:ring-primary focus:border-primary text-sm">
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1">Nombre del titular</label>
                        <input type="text" name="cardholder_name" required
                            class="w-full px-2.5 py-1.5 border border-gray-300 rounded-md focus:ring-primary focus:border-primary text-sm">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Monto</label>
                            <input type="number" name="amount" required min="0" step="0.01"
                                class="w-full px-2.5 py-1.5 border border-gray-300 rounded-md focus:ring-primary focus:border-primary text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Moneda</label>
                            <select name="currency" required
                                class="w-full px-2.5 py-1.5 border border-gray-300 rounded-md focus:ring-primary focus:border-primary text-sm">
                                <option value="EUR">EUR</option>
                                <option value="USD">USD</option>
                                <option value="VES">VES</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1">Número de tarjeta</label>
                        <input type="text" name="card_number" required pattern="[0-9 -]{16,19}"
                            class="w-full px-2.5 py-1.5 border border-gray-300 rounded-md focus:ring-primary focus:border-primary text-sm"
                            placeholder="1234 5678 9012 3456">
                    </div>

                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Mes</label>
                            <select name="expiration_month" required
                                class="w-full px-2.5 py-1.5 border border-gray-300 rounded-md focus:ring-primary focus:border-primary text-sm">
                                <% for(let i = 1; i <= 12; i++) { %>
                                    <option value="<%= i %>"><%= i.toString().padStart(2, '0') %></option>
                                <% } %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Año</label>
                            <select name="expiration_year" required
                                class="w-full px-2.5 py-1.5 border border-gray-300 rounded-md focus:ring-primary focus:border-primary text-sm">
                                <% const currentYear = new Date().getFullYear(); %>
                                <% for(let i = currentYear; i <= currentYear + 10; i++) { %>
                                    <option value="<%= i %>"><%= i %></option>
                                <% } %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">CVV</label>
                            <input type="text" name="cvv" required pattern="[0-9]{3,4}"
                                class="w-full px-2.5 py-1.5 border border-gray-300 rounded-md focus:ring-primary focus:border-primary text-sm"
                                placeholder="123">
                        </div>
                    </div>

                    <div id="payment-error" class="hidden bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded relative text-xs" role="alert">
                        <strong class="font-bold">Error: </strong>
                        <span class="block sm:inline" id="error-message"></span>
                    </div>
                    
                    <div id="payment-success" class="hidden bg-green-100 border border-green-400 text-green-700 px-3 py-2 rounded relative text-xs" role="alert">
                        <strong class="font-bold">¡Éxito! </strong>
                        <span class="block sm:inline" id="success-message">Pago procesado correctamente.</span>
                        <p class="text-xs mt-1">ID de transacción: <span id="transaction-id"></span></p>
                    </div>
                    
                    <button type="submit" id="submit-payment" class="w-full py-2 px-4 bg-primary text-white font-semibold rounded-md hover:bg-primary-dark transition duration-200 text-sm">
                        Pagar ahora
                    </button>
                </form>
                
                <script>
                function toggleTestInfo() {
                    const testInfo = document.getElementById('testInfo');
                    const toggleIcon = document.getElementById('toggleIcon');
                    testInfo.classList.toggle('hidden');
                    toggleIcon.textContent = testInfo.classList.contains('hidden') ? '▼' : '▲';
                }

                document.getElementById('paymentForm').addEventListener('submit', function(e) {
                    e.preventDefault();
                    
                    document.getElementById('payment-error').classList.add('hidden');
                    document.getElementById('payment-success').classList.add('hidden');
                    
                    const submitBtn = document.getElementById('submit-payment');
                    const originalText = submitBtn.textContent;
                    submitBtn.textContent = 'Procesando...';
                    submitBtn.disabled = true;
                    
                    fetch('/payment/add', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(Object.fromEntries(new FormData(this)))
                    })
                    .then(response => response.json())
                    .then(data => {
                        submitBtn.textContent = originalText;
                        submitBtn.disabled = false;
                        
                        if (data.message && data.status !== 'completed') {
                            document.getElementById('error-message').textContent = data.message;
                            document.getElementById('payment-error').classList.remove('hidden');
                        } else {
                            const successNotification = document.getElementById('successNotification');
                            if (successNotification) {
                                // Mostrar y animar la notificación de éxito
                                successNotification.classList.remove('hidden');
                                successNotification.classList.remove('scale-0');
                                successNotification.classList.add('scale-100');
                                
                                // Cerrar el modal de pago y la notificación después de 2.5 segundos
                                setTimeout(() => {
                                    successNotification.classList.remove('scale-100');
                                    successNotification.classList.add('scale-0');
                                    closePaymentModal();
                                    
                                    // Ocultar la notificación después de la animación
                                    setTimeout(() => {
                                        successNotification.classList.add('hidden');
                                    }, 300);
                                }, 2500);
                            }
                            
                            this.reset();
                        }
                    })
                    .catch(error => {
                        submitBtn.textContent = originalText;
                        submitBtn.disabled = false;
                        
                        document.getElementById('error-message').textContent = 'Error al procesar el pago. Inténtelo de nuevo.';
                        document.getElementById('payment-error').classList.remove('hidden');
                        console.error('Error:', error);
                    });
                });
                </script>
            </div>
        </div>
    </div>
</div>

<script>
function openPaymentModal(serviceType) {
    document.getElementById('serviceType').value = serviceType;
    document.getElementById('paymentModal').classList.remove('hidden');
}

function closePaymentModal() {
    document.getElementById('paymentModal').classList.add('hidden');
}
</script>