<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Panel de administración de 3D Print Lab para gestionar servicios de impresión 3D">
    <title>Panel de Administración - 3D Print Lab</title>
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Panel de Administración - 3D Print Lab">
    <meta property="og:description" content="Panel de administración para gestionar servicios profesionales de impresión 3D, contactos y pagos.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= typeof req !== 'undefined' ? req.protocol + '://' + req.get('host') + req.originalUrl : 'https://3dprintlab.com/admin' %>">
    <meta property="og:image" content="<%= typeof req !== 'undefined' ? req.protocol + '://' + req.get('host') : 'https://3dprintlab.com' %>/images/og-image.jpg">
    <meta property="og:image:alt" content="3D Print Lab - Panel de Administración">
    <meta property="og:site_name" content="3D Print Lab">
    <meta property="og:locale" content="es_ES">
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Panel de Administración - 3D Print Lab">
    <meta name="twitter:description" content="Panel de administración para gestionar servicios profesionales de impresión 3D.">
    <meta name="twitter:image" content="<%= typeof req !== 'undefined' ? req.protocol + '://' + req.get('host') : 'https://3dprintlab.com' %>/images/og-image.jpg">
    
    <!-- Additional SEO Meta Tags -->
    <meta name="robots" content="noindex, nofollow">
    <link rel="canonical" href="<%= typeof req !== 'undefined' ? req.protocol + '://' + req.get('host') + req.originalUrl : 'https://3dprintlab.com/admin' %>">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/gsap@3.12.2/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>
<body class="bg-gray-100">
    <nav class="bg-primary text-white p-4 shadow-lg sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-4">
                <h1 style="color: black;" class="text-2xl font-bold">Panel de Administración</h1>
                <span class="bg-secondary/20 text-black px-3 py-1 rounded-full text-sm">Admin</span>
            </div>
            <div class="flex items-center space-x-4">
                <% if (user) { %>
                    <div class="flex items-center space-x-2 text-black">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span><%= user.display_name || user.username %></span>
                    </div>
                <% } %>
                <a href="/" class="text-black hover:text-secondary transition-colors flex items-center space-x-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                    <span>Volver al sitio</span>
                </a>
                <a href="/auth/logout" class="text-black hover:text-secondary transition-colors flex items-center space-x-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                    </svg>
                    <span>Cerrar Sesión</span>
                </a>
            </div>
        </div>
    </nav>

    <div class="container mx-auto px-4 py-8">
        <!-- Resumen de Estadísticas -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-500 text-sm">Total Contactos</p>
                        <h3 class="text-2xl font-bold text-gray-800" id="totalContacts">0</h3>
                    </div>
                    <div class="bg-blue-100 p-3 rounded-full">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </div>
                </div>
                <div class="mt-4">
                    <span class="text-gray-400 text-sm">Actualizado en tiempo real</span>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-500 text-sm">Ingresos Totales</p>
                        <h3 class="text-2xl font-bold text-gray-800" id="totalRevenue">€0</h3>
                    </div>
                    <div class="bg-green-100 p-3 rounded-full">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
                <div class="mt-4">
                    <span class="text-gray-400 text-sm">Actualizado en tiempo real</span>
                </div>
            </div>
        </div>



        <!-- Accesos Rápidos -->
        <div class="grid grid-cols-1 gap-8 mb-8">
            <!-- Accesos Rápidos -->
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-bold text-gray-800 mb-4">Accesos Rápidos</h2>
                <div class="space-y-4">
                    <a href="/admin/contacts" class="flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                        <div class="bg-primary/10 p-3 rounded-full mr-4">
                            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800">Gestionar Contactos</h3>
                            <p class="text-sm text-gray-500">Ver y responder mensajes</p>
                        </div>
                    </a>

                    <a href="/admin/payments" class="flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                        <div class="bg-primary/10 p-3 rounded-full mr-4">
                            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800">Gestionar Pagos</h3>
                            <p class="text-sm text-gray-500">Supervisar transacciones</p>
                        </div>
                    </a>

                    <a href="/auth/register" class="flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                        <div class="bg-primary/10 p-3 rounded-full mr-4">
                            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-gray-800">Crear Usuario</h3>
                            <p class="text-sm text-gray-500">Registrar nuevo administrador</p>
                        </div>
                    </a>


                </div>
            </div>
        </div>

        <!-- Gráfico de Actividad -->
        <div class="bg-white rounded-lg shadow p-6 mb-8">
            <h2 class="text-xl font-bold text-gray-800 mb-4">Actividad del Mes</h2>
            <div class="relative h-64">
                <canvas id="activityChart"></canvas>
            </div>
        </div>
    </div>

    <script>
        // Función para actualizar el contador de contactos
        async function updateContactCount() {
            try {
                // Obtener el conteo total de contactos
                const response = await fetch('/api/contacts/count');
                
                if (!response.ok) {
                    console.error('Error en respuesta de API de conteo de contactos:', response.status);
                    document.getElementById('totalContacts').textContent = '0';
                    return;
                }
                
                const data = await response.json();
                console.log('Datos de conteo de contactos recibidos:', data);
                
                if (data && typeof data.count === 'number') {
                    document.getElementById('totalContacts').textContent = data.count;
                } else {
                    console.error('Estructura de datos de conteo incorrecta:', data);
                    document.getElementById('totalContacts').textContent = '0';
                }
            } catch (error) {
                console.error('Error al obtener el conteo de contactos:', error);
                document.getElementById('totalContacts').textContent = '0';
            }
        }

        // Función para actualizar los ingresos totales
        async function updateTotalRevenue() {
            try {
                const response = await fetch('/api/payments/total');
                
                if (!response.ok) {
                    console.error('Error en respuesta de API de pagos:', response.status);
                    document.getElementById('totalRevenue').textContent = '€0.00';
                    return;
                }
                
                const data = await response.json();
                console.log('Datos de ingresos totales recibidos:', data);
                
                if (data && typeof data.total !== 'undefined') {
                    const total = parseFloat(data.total);
                    document.getElementById('totalRevenue').textContent = `€${isNaN(total) ? '0.00' : total.toFixed(2)}`;
                } else {
                    console.error('Estructura de datos de pagos incorrecta:', data);
                    document.getElementById('totalRevenue').textContent = '€0.00';
                }
            } catch (error) {
                console.error('Error al obtener los ingresos totales:', error);
                document.getElementById('totalRevenue').textContent = '€0.00';
            }
        }

        // Inicializar datos
        updateContactCount();
        updateTotalRevenue();

        // Actualizar datos cada minuto
        setInterval(() => {
            updateContactCount();
            updateTotalRevenue();
        }, 60000);

        // Función para obtener datos de actividad mensual
        async function fetchMonthlyActivity() {
            try {
                let paymentsData = [];
                let contactsData = [];
                
                // Obtener datos de pagos mensuales
                const paymentsMonthlyResponse = await fetch('/api/payments/monthly');
                if (paymentsMonthlyResponse.ok) {
                    paymentsData = await paymentsMonthlyResponse.json();
                    console.log('Datos mensuales de pagos recibidos:', paymentsData);
                } else {
                    console.error('Error al obtener datos de pagos:', paymentsMonthlyResponse.status);
                }
                
                // Procesar datos de contactos mensuales
                const contactsMonthlyResponse = await fetch('/api/contacts/monthly');
                if (contactsMonthlyResponse.ok) {
                    contactsData = await contactsMonthlyResponse.json();
                    console.log('Datos mensuales de contactos recibidos:', contactsData);
                } else {
                    // Si falla, intentar con datos diarios
                    const contactsResponse = await fetch('/api/contacts/daily');
                    if (contactsResponse.ok) {
                        const dailyData = await contactsResponse.json();
                        contactsData = dailyData.data || dailyData;
                        console.log('Datos diarios de contactos recibidos:', contactsData);
                    } else {
                        console.error('Error al obtener datos de contactos:', contactsResponse.status);
                    }
                }
                
                // Obtener también los totales actuales para asegurar que se muestren en el gráfico
                try {
                    const totalRevenueResponse = await fetch('/api/payments/total');
                    if (totalRevenueResponse.ok) {
                        const totalData = await totalRevenueResponse.json();
                        if (totalData && typeof totalData.total !== 'undefined') {
                            paymentsData.total = totalData.total;
                        }
                    }
                    
                    const contactCountResponse = await fetch('/api/contacts/count');
                    if (contactCountResponse.ok) {
                        const countData = await contactCountResponse.json();
                        if (countData && typeof countData.count !== 'undefined') {
                            contactsData.count = countData.count;
                        }
                    }
                } catch (e) {
                    console.error('Error al obtener totales:', e);
                }
                
                return { payments: paymentsData, contacts: contactsData };
            } catch (error) {
                console.error('Error al obtener datos de actividad mensual:', error);
                return { payments: [], contacts: [] };
            }
        }

        // Función para inicializar el gráfico de actividad
        async function initActivityChart() {
            const ctx = document.getElementById('activityChart').getContext('2d');
            
            // Obtener datos
            const { payments, contacts } = await fetchMonthlyActivity();
            
            // Preparar datos para el gráfico
            const currentDate = new Date();
            const daysInMonth = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0).getDate();
            const labels = Array.from({ length: daysInMonth }, (_, i) => i + 1);
            
            // Inicializar arrays con ceros
            const paymentsData = new Array(daysInMonth).fill(0);
            const contactsData = new Array(daysInMonth).fill(0);
            
            console.log('Procesando datos de pagos:', payments);
            console.log('Procesando datos de contactos:', contacts);
            
            // Verificar si hay datos de pagos
            if (payments) {
                // Llenar datos de pagos - verificar si es un array o un objeto con propiedades
                if (Array.isArray(payments)) {
                    payments.forEach(item => {
                        try {
                            // Intentar obtener el día del mes desde la fecha
                            const day = item.day ? parseInt(item.day) : (item.date ? new Date(item.date).getDate() : 0);
                            if (day >= 1 && day <= daysInMonth) {
                                paymentsData[day - 1] = item.count || 0;
                            }
                        } catch (error) {
                            console.error('Error al procesar dato de pago:', item, error);
                        }
                    });
                } else if (typeof payments === 'object') {
                    // Si es un objeto con propiedades days y amounts
                    if (Array.isArray(payments.days) && Array.isArray(payments.amounts)) {
                        payments.days.forEach((day, index) => {
                            if (day >= 1 && day <= daysInMonth && index < payments.amounts.length) {
                                paymentsData[day - 1] = payments.amounts[index] || 0;
                            }
                        });
                    }
                    
                    // Si hay un valor total, asegurarse de que se muestre en el día actual
                    if (payments.total && typeof payments.total === 'number' && payments.total > 0) {
                        const currentDay = currentDate.getDate();
                        if (currentDay >= 1 && currentDay <= daysInMonth) {
                            // Si no hay datos para el día actual, usar el total
                            if (paymentsData[currentDay - 1] === 0) {
                                paymentsData[currentDay - 1] = payments.total;
                            }
                        }
                    }
                }
            }
            
            // Verificar si hay datos de contactos
            if (contacts) {
                // Llenar datos de contactos - verificar si es un array o un objeto con propiedades
                if (Array.isArray(contacts)) {
                    contacts.forEach(item => {
                        try {
                            // Intentar obtener el día del mes desde la fecha
                            const day = item.day ? parseInt(item.day) : (item.date ? new Date(item.date).getDate() : 0);
                            if (day >= 1 && day <= daysInMonth) {
                                contactsData[day - 1] = item.count || 0;
                            }
                        } catch (error) {
                            console.error('Error al procesar dato de contacto:', item, error);
                        }
                    });
                } else if (typeof contacts === 'object') {
                    // Si es un objeto con propiedades days y contacts
                    if (Array.isArray(contacts.days) && Array.isArray(contacts.contacts)) {
                        contacts.days.forEach((day, index) => {
                            if (day >= 1 && day <= daysInMonth && index < contacts.contacts.length) {
                                contactsData[day - 1] = contacts.contacts[index] || 0;
                            }
                        });
                    }
                    
                    // Si hay un valor count, asegurarse de que se muestre en el día actual
                    if (contacts.count && typeof contacts.count === 'number') {
                        const currentDay = currentDate.getDate();
                        if (currentDay >= 1 && currentDay <= daysInMonth) {
                            // Solo actualizar el día actual si no hay datos previos
                            if (!contactsData.some((value, index) => index === currentDay - 1 && value > 0)) {
                                contactsData[currentDay - 1] = contacts.count;
                            }
                        }
                    }
                }
            }
            
            // Asegurarse de que haya al menos un valor para el día actual si hay datos disponibles
            const currentDay = currentDate.getDate();
            if (document.getElementById('totalRevenue').textContent !== '€0.00' && paymentsData[currentDay - 1] === 0) {
                const totalText = document.getElementById('totalRevenue').textContent;
                const totalValue = parseFloat(totalText.replace('€', ''));
                if (!isNaN(totalValue) && totalValue > 0) {
                    paymentsData[currentDay - 1] = totalValue;
                }
            }
            
            console.log('Datos procesados para el gráfico:');
            console.log('Días:', labels);
            console.log('Datos de pagos:', paymentsData);
            console.log('Datos de contactos:', contactsData);
            
            // Crear gráfico
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Pagos (€)',
                            data: paymentsData,
                            backgroundColor: 'rgba(34, 197, 94, 0.5)',
                            borderColor: 'rgb(34, 197, 94)',
                            borderWidth: 1
                        },
                        {
                            label: 'Contactos',
                            data: contactsData,
                            backgroundColor: 'rgba(59, 130, 246, 0.5)',
                            borderColor: 'rgb(59, 130, 246)',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Día del mes'
                            }
                        }
                    },
                    plugins: {
                        title: {
                            display: true,
                            text: 'Actividad Diaria del Mes'
                        },
                        tooltip: {
                            callbacks: {
                                title: function(tooltipItems) {
                                    return 'Día ' + tooltipItems[0].label;
                                }
                            }
                        }
                    }
                }
            });
        }

        // Animaciones de entrada
        gsap.from('.grid > div', {
            duration: 0.6,
            opacity: 0,
            y: 20,
            stagger: 0.1,
            ease: 'power2.out'
        });
        
        // Inicializar gráfico
        initActivityChart();
    </script>
</body>
</html>
