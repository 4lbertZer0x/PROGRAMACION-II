<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Administración de contactos de 3D Print Lab para gestionar consultas de clientes">
    <title>Administración de Contactos - 3D Print Lab</title>
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Administración de Contactos - 3D Print Lab">
    <meta property="og:description" content="Panel de administración para gestionar contactos y consultas de clientes de servicios de impresión 3D.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= typeof req !== 'undefined' ? req.protocol + '://' + req.get('host') + req.originalUrl : 'https://3dprintlab.com/admin/contacts' %>">
    <meta property="og:image" content="<%= typeof req !== 'undefined' ? req.protocol + '://' + req.get('host') : 'https://3dprintlab.com' %>/images/og-image.jpg">
    <meta property="og:image:alt" content="3D Print Lab - Administración de Contactos">
    <meta property="og:site_name" content="3D Print Lab">
    <meta property="og:locale" content="es_ES">
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Administración de Contactos - 3D Print Lab">
    <meta name="twitter:description" content="Panel de administración para gestionar contactos y consultas de clientes.">
    <meta name="twitter:image" content="<%= typeof req !== 'undefined' ? req.protocol + '://' + req.get('host') : 'https://3dprintlab.com' %>/images/og-image.jpg">
    
    <!-- Additional SEO Meta Tags -->
    <meta name="robots" content="noindex, nofollow">
    <link rel="canonical" href="<%= typeof req !== 'undefined' ? req.protocol + '://' + req.get('host') + req.originalUrl : 'https://3dprintlab.com/admin/contacts' %>">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/gsap@3.12.2/dist/gsap.min.js"></script>
</head>
<body class="bg-gray-100">
    <nav class="bg-primary text-white p-4 shadow-lg sticky top-0 z-50">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-4">
                <h1 class="text-2xl font-bold text-black">Administración de Contactos</h1>
                <span class="bg-secondary/20 text-black px-3 py-1 rounded-full text-sm">Admin</span>
            </div>
            <div class="flex items-center space-x-4">
                <% if (user) { %>
                    <div class="flex items-center space-x-2 text-black">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span><%= user.display_name || user.username %></span>
                    </div>
                <% } %>
                <a href="/admin" class="text-black hover:text-secondary transition-colors flex items-center space-x-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 15l-3-3m0 0l3-3m-3 3h8M3 12a9 9 0 1118 0 9 9 0 01-18 0z"></path>
                    </svg>
                    <span>Volver al Panel</span>
                </a>
                <a href="/auth/logout" class="text-black hover:text-secondary transition-colors flex items-center space-x-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                    </svg>
                    <span>Cerrar Sesión</span>
                </a>
            </div>
        </div>
    </nav>
    <div class="container mx-auto px-4 py-8">
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-bold">Administración de Contactos</h1>
            <div class="flex space-x-4">
                <input type="text" id="searchInput" placeholder="Buscar..." class="px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:outline-none transition-all duration-300">
                <select id="filterSelect" class="px-4 py-2 border rounded-lg focus:ring-2 focus:ring-primary focus:outline-none transition-all duration-300">
                    <option value="all">Todos</option>
                    <option value="today">Hoy</option>
                    <option value="week">Esta semana</option>
                    <option value="month">Este mes</option>
                </select>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-lg overflow-hidden transition-all duration-300 hover:shadow-xl">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider cursor-pointer hover:bg-gray-100 transition-colors duration-200">ID</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider cursor-pointer hover:bg-gray-100 transition-colors duration-200">Nombre</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider cursor-pointer hover:bg-gray-100 transition-colors duration-200">Email</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider cursor-pointer hover:bg-gray-100 transition-colors duration-200">Comentario</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider cursor-pointer hover:bg-gray-100 transition-colors duration-200">IP</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider cursor-pointer hover:bg-gray-100 transition-colors duration-200">País</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider cursor-pointer hover:bg-gray-100 transition-colors duration-200">Fecha</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200" id="contactsTableBody">
                        <% if (contacts && Array.isArray(contacts) && contacts.length > 0) { %>
                            <% contacts.forEach((contact, index) => { %>
                                <tr class="contact-row hover:bg-gray-50 transition-colors duration-200" data-index="<%= index %>">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= contact.id || '-' %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= contact.name || '-' %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= contact.email || '-' %></td>
                                    <td class="px-6 py-4 text-sm text-gray-500 max-w-md truncate"><%- contact.comment ? contact.comment.replace(/</g, '&lt;').replace(/>/g, '&gt;') : '-' %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= contact.ip_address || '-' %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= contact.country || 'No disponible' %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        <% if (contact.created_at) { %>
                                            <%= new Date(contact.created_at).toLocaleString('es-ES', { day: 'numeric', month: 'numeric', year: 'numeric', hour: 'numeric', minute: 'numeric', second: 'numeric', hour12: true }) %>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="px-6 py-4 text-center text-sm text-gray-500">No hay contactos disponibles</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        // Animación de entrada para las filas
        gsap.from('.contact-row', {
            duration: 0.5,
            opacity: 0,
            y: 20,
            stagger: 0.1,
            ease: 'power2.out'
        });

        // Función para normalizar texto (remover acentos y convertir a minúsculas)
        function normalizeText(text) {
            return text.toLowerCase()
                      .normalize('NFD')
                      .replace(/[\u0300-\u036f]/g, '');
        }

        // Funcionalidad de búsqueda
        const searchInput = document.getElementById('searchInput');
        const filterSelect = document.getElementById('filterSelect');
        const rows = document.querySelectorAll('.contact-row');

        function filterContacts() {
            const searchTerm = normalizeText(searchInput.value);
            const filterValue = filterSelect.value;
            const now = new Date();

            rows.forEach(row => {
                const text = normalizeText(row.textContent);
                const dateCell = row.querySelector('td:last-child').textContent;
                const date = dateCell !== '-' ? new Date(dateCell) : null;
                let showByDate = true;

                if (filterValue === 'today' && date) {
                    showByDate = date.toDateString() === now.toDateString();
                } else if (filterValue === 'week' && date) {
                    const weekAgo = new Date(now - 7 * 24 * 60 * 60 * 1000);
                    showByDate = date >= weekAgo;
                } else if (filterValue === 'month' && date) {
                    showByDate = date.getMonth() === now.getMonth() && date.getFullYear() === now.getFullYear();
                }

                const show = text.includes(searchTerm) && showByDate;
                row.style.display = show ? '' : 'none';

                if (show) {
                    gsap.to(row, {
                        opacity: 1,
                        y: 0,
                        duration: 0.3,
                        ease: 'power2.out'
                    });
                }
            });
        }

        searchInput.addEventListener('input', filterContacts);
        filterSelect.addEventListener('change', filterContacts);
    </script>
</body>
</html>
