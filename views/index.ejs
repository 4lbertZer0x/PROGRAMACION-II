                            <textarea id="message" name="message" rows="4" class="form-textarea focus:ring-2 focus:ring-primary" placeholder="Cuéntanos sobre tu proyecto..." required></textarea>
                            <span class="text-sm text-red-500 hidden" id="message-error"></span>
                        </div>
                        <div class="flex items-start space-x-2">
                            <input type="checkbox" id="privacy" name="privacy" class="mt-1 transition-all duration-300 focus:ring-2 focus:ring-primary" required>
