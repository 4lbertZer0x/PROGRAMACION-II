<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Regístrate en 3D Print Lab para acceder a servicios profesionales de impresión 3D">
    <title><%= title %> - 3D Print Lab</title>
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="<%= title %> - 3D Print Lab">
    <meta property="og:description" content="Regístrate en 3D Print Lab para acceder a servicios profesionales de impresión 3D para prototipos y figuras personalizadas.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= typeof req !== 'undefined' ? req.protocol + '://' + req.get('host') + req.originalUrl : 'https://3dprintlab.com/auth/register' %>">
    <meta property="og:image" content="<%= typeof req !== 'undefined' ? req.protocol + '://' + req.get('host') : 'https://3dprintlab.com' %>/images/og-image.jpg">
    <meta property="og:image:alt" content="3D Print Lab - Registro">
    <meta property="og:site_name" content="3D Print Lab">
    <meta property="og:locale" content="es_ES">
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %> - 3D Print Lab">
    <meta name="twitter:description" content="Regístrate en 3D Print Lab para acceder a servicios profesionales de impresión 3D.">
    <meta name="twitter:image" content="<%= typeof req !== 'undefined' ? req.protocol + '://' + req.get('host') : 'https://3dprintlab.com' %>/images/og-image.jpg">
    
    <!-- Additional SEO Meta Tags -->
    <meta name="robots" content="noindex, nofollow">
    <link rel="canonical" href="<%= typeof req !== 'undefined' ? req.protocol + '://' + req.get('host') + req.originalUrl : 'https://3dprintlab.com/auth/register' %>">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#3B4D71',
                        secondary: '#D4AF37',
                        neutral: '#F5F5F5',
                        dark: '#1A1A1A',
                    },
                    fontFamily: {
                        'poppins': ['Poppins', 'sans-serif'],
                        'inter': ['Inter', 'sans-serif'],
                    },
                }
            }
        }
    </script>
</head>
<body class="font-poppins text-dark bg-neutral min-h-screen flex items-center justify-center">
    <div class="max-w-md w-full mx-4">
        <!-- Logo y título -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-primary mb-2">3D Print Lab</h1>
            <p class="text-gray-600">Registrar Nuevo Usuario</p>
            <p class="text-sm text-gray-500 mt-1">Solo administradores pueden crear usuarios</p>
        </div>

        <!-- Mensajes flash -->
        <% if (messages.error && messages.error.length > 0) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                <% messages.error.forEach(function(error) { %>
                    <p><%= error %></p>
                <% }); %>
            </div>
        <% } %>

        <% if (messages.success && messages.success.length > 0) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
                <% messages.success.forEach(function(success) { %>
                    <p><%= success %></p>
                <% }); %>
            </div>
        <% } %>

        <!-- Formulario de registro -->
        <div class="bg-white rounded-lg shadow-lg p-8">
            <form action="/auth/register" method="POST" class="space-y-6" id="registerForm">
                <!-- Campo de nombre de usuario -->
                <div>
                    <label for="username" class="block text-sm font-medium text-gray-700 mb-2">
                        Nombre de Usuario *
                    </label>
                    <input 
                        type="text" 
                        id="username" 
                        name="username" 
                        required 
                        minlength="3"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                        placeholder="Mínimo 3 caracteres"
                    >
                    <p class="text-xs text-gray-500 mt-1">Este será el nombre para iniciar sesión</p>
                </div>

                <!-- Campo de contraseña -->
                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-2">
                        Contraseña *
                    </label>
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        required 
                        minlength="6"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                        placeholder="Mínimo 6 caracteres"
                    >
                </div>

                <!-- Campo de confirmación de contraseña -->
                <div>
                    <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-2">
                        Confirmar Contraseña *
                    </label>
                    <input 
                        type="password" 
                        id="confirmPassword" 
                        name="confirmPassword" 
                        required 
                        minlength="6"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                        placeholder="Repite la contraseña"
                    >
                </div>

                <!-- Campo de email (opcional) -->
                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                        Email (opcional)
                    </label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                        placeholder="usuario@ejemplo.com"
                    >
                </div>

                <!-- Campo de nombre para mostrar (opcional) -->
                <div>
                    <label for="display_name" class="block text-sm font-medium text-gray-700 mb-2">
                        Nombre para Mostrar (opcional)
                    </label>
                    <input 
                        type="text" 
                        id="display_name" 
                        name="display_name" 
                        class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                        placeholder="Nombre completo o apodo"
                    >
                    <p class="text-xs text-gray-500 mt-1">Si no se especifica, se usará el nombre de usuario</p>
                </div>

                <!-- Botones -->
                <div class="flex space-x-4">
                    <button 
                        type="submit" 
                        class="flex-1 bg-primary text-white py-2 px-4 rounded-md hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 transition duration-200"
                    >
                        Crear Usuario
                    </button>
                    <a 
                        href="/admin" 
                        class="flex-1 bg-gray-500 text-white py-2 px-4 rounded-md hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 transition duration-200 text-center"
                    >
                        Cancelar
                    </a>
                </div>
            </form>
        </div>

        <!-- Enlaces adicionales -->
        <div class="text-center mt-6">
            <a href="/admin" class="text-primary hover:text-primary/80 text-sm">
                ← Volver al panel de administración
            </a>
        </div>
    </div>

    <script>
        // Auto-focus en el primer campo
        document.getElementById('username').focus();
        
        // Validación del formulario
        document.getElementById('registerForm').addEventListener('submit', function(e) {
            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const email = document.getElementById('email').value.trim();
            
            // Validar campos requeridos
            if (!username || !password || !confirmPassword) {
                e.preventDefault();
                alert('Por favor, completa todos los campos obligatorios.');
                return;
            }
            
            // Validar longitud mínima
            if (username.length < 3) {
                e.preventDefault();
                alert('El nombre de usuario debe tener al menos 3 caracteres.');
                return;
            }
            
            if (password.length < 6) {
                e.preventDefault();
                alert('La contraseña debe tener al menos 6 caracteres.');
                return;
            }
            
            // Validar que las contraseñas coincidan
            if (password !== confirmPassword) {
                e.preventDefault();
                alert('Las contraseñas no coinciden.');
                return;
            }
            
            // Validar email si se proporciona
            if (email && !isValidEmail(email)) {
                e.preventDefault();
                alert('Por favor, ingresa un email válido.');
                return;
            }
        });
        
        // Función para validar email
        function isValidEmail(email) {
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return emailRegex.test(email);
        }
        
        // Validación en tiempo real de confirmación de contraseña
        document.getElementById('confirmPassword').addEventListener('input', function() {
            const password = document.getElementById('password').value;
            const confirmPassword = this.value;
            
            if (confirmPassword && password !== confirmPassword) {
                this.setCustomValidity('Las contraseñas no coinciden');
                this.classList.add('border-red-500');
                this.classList.remove('border-gray-300');
            } else {
                this.setCustomValidity('');
                this.classList.remove('border-red-500');
                this.classList.add('border-gray-300');
            }
        });
    </script>
</body>
</html>
